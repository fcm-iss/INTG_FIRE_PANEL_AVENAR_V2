<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
	  <!--opc: IP o hostname del servidor OPC DA (Avenar). "localhost" si el panel corre en esta misma máquina-->
    <add key="opc_host" value="localhost" />
      <!--credenciales DCOM opcionales para la conexion OPC. Vacio = usar la identidad del proceso actual-->
    <add key="opc_username" value="" />
    <add key="opc_password" value="" />
    <add key="opc_domain" value="" />
      <!--configuracion de securos-->
    <add key="securos_host" value="127.0.0.1" />
    <add key="securos_port" value="3000" />
    <add key="username" value="ISS" />
    <add key="password" value="pass" />
          <!--datos de securos-->
    <add key="securos_service_name" value="VmsServer" /><!--nombre del servicio de securos que corre en la maquina local, por defecto VmsServer-->
    <add key="output_base_dir" value="C:\ISS_WORKSPACE\SSA_INTG_BOSCH_AVENAR\INTG_OPCAvenar_IIDKSecuros_V2.0\INTG_FIRE_PANEL_AVENAR" />
    <add key="securos_install_dir" value="C:\Program Files (x86)\ISS\SecurOS" />
    <add key="securos_integration_dir" value="C:\Program Files (x86)\ISS\SecurOS\integrations" />
    <!--carpeta donde se debe buscar iidk.dll (dependencia nativa del IDK de SecurOS). Vacio = usar la resolucion automatica del SDK-->
    <add key="iidk_dll_directory" value="C:\Program Files (x86)\ISS\SecurOS" />
      
      <!--datos de integracion-->
    <add key="idUinP" value="1" />	
    <add key="ddi_prefix" value="AVEJ3_" />
    <!--<add key="integration_point_name" value="Avenar" />-->
    <add key="allowed_types" value="" /> <!--listado de elementos que se van a procesar, si se deja vacio se procesan todos los elementos-->	  
    
	  <!--configuracion de tiempos-->
	<add key="monitoring_update_rate_ms" value="500" />
    <add key="watchdog_check_interval_ms" value="5000" />
    <add key="watchdog_reconnect_interval_ms" value="10000" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.0.0" newVersion="4.2.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>